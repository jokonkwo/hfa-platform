# ============================================
# Healthy Fresno Air (HFA) — Environment Config
# Copy to .env (repo root) and fill values.
# DO NOT COMMIT .env (it is gitignored).
# ============================================

# ----------------------------
# App Environment
# ----------------------------
HFA_ENV=local                     # local | staging | prod
HFA_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# ----------------------------
# Warehouse / Database
# ----------------------------
# Local DuckDB file path (used when HFA_WAREHOUSE_MODE=local)
HFA_DUCKDB_PATH=./data/local/hfa.duckdb

# Warehouse mode determines where queries are executed
# local: DuckDB file
# motherduck: MotherDuck database (DuckDB in the cloud)
HFA_WAREHOUSE_MODE=local          # local | motherduck

# MotherDuck connection
# Example DB name: hfa_dev
MOTHERDUCK_DATABASE=hfa_dev
MOTHERDUCK_TOKEN=                 # set in local .env / GitHub Secrets

# ----------------------------
# PurpleAir Ingestion
# ----------------------------
PURPLEAIR_API_KEY=                # required to pull sensor data
PURPLEAIR_READ_KEY=               # optional depending on endpoint usage

# Optional: restrict ingestion to a known set of sensor IDs (comma-separated)
PURPLEAIR_SENSOR_IDS=

# Cadence settings (used by schedulers / jobs)
INGESTION_INTERVAL_MINUTES=10

# ----------------------------
# Geo / Reference Data
# ----------------------------
# Where raw boundary/demographic files can be staged locally (not committed)
HFA_DATA_EXTERNAL_DIR=./data/external

CENSUS_API_KEY= ffb711b53f05bd0f8066196a3640ff60c3db8368

# ----------------------------
# Alerts / Notifications
# ----------------------------
# Slack Incoming Webhook URL for pipeline failure & freshness alerts
SLACK_WEBHOOK_URL=

# Freshness breach threshold: alert if newest reading older than this many minutes
DATA_FRESHNESS_BREACH_MINUTES=30

# ----------------------------
# API Service (FastAPI)
# ----------------------------
API_HOST=0.0.0.0
API_PORT=8000

# If/when you add caching (optional later)
CACHE_MODE=none                   # none | memory | redis
REDIS_URL=redis://localhost:6379/0

# ----------------------------
# Frontend (Next.js)
# ----------------------------
# Used by the web app to call the API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
